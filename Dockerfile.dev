# ✅ Dockerfile optimizado para DESARROLLO
FROM node:24-alpine

# Habilitar pnpm
RUN corepack enable

# Configurar CI para evitar prompts interactivos
ENV CI=true

WORKDIR /app

# Copiar archivos de configuración incluyendo .npmrc
COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

RUN pnpm install

COPY . .

EXPOSE 3600

CMD ["pnpm", "run", "start:dev"]
